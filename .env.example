# Database (Neon PostgreSQL)
# Uses PORTAL_DATABASE_URL to avoid collision with platform DATABASE_URL
PORTAL_DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require"

# AMPRE RESO Web API (TRREB IDX/DLA feed)
# Token generated at syndication.ampre.ca/tokens — displays only once
AMPRE_API_TOKEN=
AMPRE_API_URL="https://query.ampre.ca/odata"

# Secret for triggering sync via API (generate a random string)
MLS_SYNC_SECRET=

# Vercel cron secret (set in Vercel dashboard → Settings → Environment Variables)
CRON_SECRET=

# JWT secret — generate a strong random string
JWT_SECRET="change-me-to-a-secure-random-string"

# Document encryption key — 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY="generate-a-64-char-hex-string"

# Upload directory for encrypted documents (absolute path recommended in production)
UPLOAD_DIR="./uploads"

# App
NEXT_PUBLIC_APP_NAME="Cory Wong Real Estate"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags (set to "true" to enable; defaults to disabled)
NEXT_PUBLIC_FEATURE_MESSAGING=false
NEXT_PUBLIC_FEATURE_TRANSACTIONS=false
NEXT_PUBLIC_AMPRE_FEED_LIVE=false
