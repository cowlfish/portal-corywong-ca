    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "nanoid": "^3.3.12",
    "next": "^16.4.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.2.4",
